{
  "name": "@tapestry/app",
  "version": "0.1.0",
  "description": "Tapestry desktop application — Electron shell with C++ kernel bridge",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build:native": "cmake-js build --directory native -O native/build",
    "dev": "electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "postinstall": "npm run build:native"
  },
  "dependencies": {
    "prosemirror-commands": "^1.6.0",
    "prosemirror-history": "^1.4.0",
    "prosemirror-keymap": "^1.2.0",
    "prosemirror-model": "^1.24.0",
    "prosemirror-schema-basic": "^1.2.0",
    "prosemirror-state": "^1.4.0",
    "prosemirror-view": "^1.38.0"
  },
  "devDependencies": {
    "cmake-js": "^7.3.0",
    "electron": "^32.0.0",
    "electron-vite": "^2.3.0",
    "node-addon-api": "^8.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
