{
  "name": "View: 2D identity",
  "description": "The default view of a 2D space: project.expr [self.position.x, self.position.y] puts every note where the page already draws it, so the Mathspace stage panel shows the same picture as the canvas. Two notes in the tree's own space, one drifting along +x so the panel visibly moves under mathspace.run.",
  "nodes": [
    {
      "type": "mathspace/view@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Page view"
        },
        "position.x": {
          "type": "real",
          "value": -160
        },
        "position.y": {
          "type": "real",
          "value": -120
        },
        "project.expr": {
          "type": "text",
          "value": "[self.position.x, self.position.y]"
        }
      }
    },
    {
      "type": "tapestry.notes/note@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Still"
        },
        "body": {
          "type": "text",
          "value": ""
        },
        "position.x": {
          "type": "real",
          "value": 0
        },
        "position.y": {
          "type": "real",
          "value": 0
        }
      }
    },
    {
      "type": "tapestry.notes/note@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Drifting"
        },
        "body": {
          "type": "text",
          "value": ""
        },
        "position.x": {
          "type": "real",
          "value": 60
        },
        "position.y": {
          "type": "real",
          "value": 40
        },
        "velocity.x": {
          "type": "real",
          "value": 1
        },
        "velocity.y": {
          "type": "real",
          "value": 0
        }
      }
    }
  ]
}
