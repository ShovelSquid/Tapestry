{
  "name": "View: 3D, perspective and three orthographic",
  "description": "A 3-space (its own mathspace/space@1 node) with three notes, seen through four View nodes at once: a perspective camera 400 units in front of the origin (project.expr [self.position.x, self.position.y] * 400 / (self.position.z + 400)) and the three orthographic axis planes xy, xz and yz. One note drifts along +z so the perspective panel shows it shrinking while the xy panel does not move. Edit a View's project.expr to move its camera; add Views for more panels.",
  "nodes": [
    {
      "type": "mathspace/space@1",
      "props": {
        "title": {
          "type": "text",
          "value": "3-space"
        },
        "dim": {
          "type": "int",
          "value": 3
        }
      }
    },
    {
      "type": "tapestry.notes/note@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Origin"
        },
        "body": {
          "type": "text",
          "value": ""
        },
        "space": {
          "type": "ref",
          "value": "$0"
        },
        "position.x": {
          "type": "real",
          "value": 0
        },
        "position.y": {
          "type": "real",
          "value": 0
        },
        "position.z": {
          "type": "real",
          "value": 0
        }
      }
    },
    {
      "type": "tapestry.notes/note@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Corner"
        },
        "body": {
          "type": "text",
          "value": ""
        },
        "space": {
          "type": "ref",
          "value": "$0"
        },
        "position.x": {
          "type": "real",
          "value": 120
        },
        "position.y": {
          "type": "real",
          "value": 80
        },
        "position.z": {
          "type": "real",
          "value": -100
        }
      }
    },
    {
      "type": "tapestry.notes/note@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Receding"
        },
        "body": {
          "type": "text",
          "value": ""
        },
        "space": {
          "type": "ref",
          "value": "$0"
        },
        "position.x": {
          "type": "real",
          "value": -80
        },
        "position.y": {
          "type": "real",
          "value": 40
        },
        "position.z": {
          "type": "real",
          "value": 0
        },
        "velocity.x": {
          "type": "real",
          "value": 0
        },
        "velocity.y": {
          "type": "real",
          "value": 0
        },
        "velocity.z": {
          "type": "real",
          "value": 2
        }
      }
    },
    {
      "type": "mathspace/view@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Perspective"
        },
        "space": {
          "type": "ref",
          "value": "$0"
        },
        "position.x": {
          "type": "real",
          "value": -240
        },
        "position.y": {
          "type": "real",
          "value": -160
        },
        "project.expr": {
          "type": "text",
          "value": "[self.position.x, self.position.y] * 400 / (self.position.z + 400)"
        }
      }
    },
    {
      "type": "mathspace/view@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Top (xy)"
        },
        "space": {
          "type": "ref",
          "value": "$0"
        },
        "position.x": {
          "type": "real",
          "value": -240
        },
        "position.y": {
          "type": "real",
          "value": -80
        },
        "project.expr": {
          "type": "text",
          "value": "[self.position.x, self.position.y]"
        }
      }
    },
    {
      "type": "mathspace/view@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Front (xz)"
        },
        "space": {
          "type": "ref",
          "value": "$0"
        },
        "position.x": {
          "type": "real",
          "value": -240
        },
        "position.y": {
          "type": "real",
          "value": 0
        },
        "project.expr": {
          "type": "text",
          "value": "[self.position.x, self.position.z]"
        }
      }
    },
    {
      "type": "mathspace/view@1",
      "props": {
        "title": {
          "type": "text",
          "value": "Side (yz)"
        },
        "space": {
          "type": "ref",
          "value": "$0"
        },
        "position.x": {
          "type": "real",
          "value": -240
