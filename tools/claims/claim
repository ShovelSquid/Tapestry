    "session-end": hook_session_end,
    "prompt": hook_prompt,
}


# ---------- commands ----------


def mine():
    s = enclosing_session()
    if not s:
        sys.exit("claim: not running inside a Claude Code session (set CLAIM_SESSION=<session id> to act as one)")
    rec = register(s["sessionId"], os.getcwd())
    return rec


def cmd_task(a):
    rec = mine()
    rec["task"] = " ".join(a.text)
    save(rec)
    print(f"{who(rec)}: {rec['task']}")


def cmd_add(a):
    rec = mine()
    for p in a.paths:
        path = os.path.realpath(p)
        root, repo = where(path)
        lock = a.lock or ("parts" if a.part else "whole")
        if lock == "parts" and not a.part:
            sys.exit("claim: --lock parts needs at least one --part")
        if a.part and os.path.exists(path):
            text = Path(path).read_text()
            found = {g[0] for g in regions(text, a.part)}
            missing = [x for x in a.part if x not in found]
            if missing:
                sys.exit(f"claim: not found in {p}: {', '.join(missing)}")
        here, _, _ = claims_on(path, rec["session"])
        for r, l, c in here:
            if l and c.get("lock") == "whole":
                print(f"note: {who(r)} already holds all of {p}: {c.get('note')}", file=sys.stderr)
        rec["claims"] = [c for c in rec["claims"] if c["path"] != path]
        rec["claims"].append({"path": path, "root": root, "repo": repo, "rel": rel(path, root),
                              "parts": a.part or [], "lock": lock, "note": a.m or "", "at": time.time()})
        print(f"claimed {rel(path, root)} ({lock}{': ' + ', '.join(a.part) if a.part else ''})")
    save(rec)


def cmd_release(a):
    rec = mine()
    if a.all:
        rec["claims"] = []
    else:
        drop = {os.path.realpath(p) for p in a.paths}
        rec["claims"] = [c for c in rec["claims"] if c["path"] not in drop]
    save(rec)
    print(f"{len(rec['claims'])} claims left")


def board(include_dormant=True):
    live = live_sessions()
    rows = []
    for r in sorted(all_records(), key=lambda r: r.get("name", "")):
        is_live = r["session"] in live
        if not is_live and (not include_dormant or not r.get("claims")):
            continue
        name = (live.get(r["session"], {}).get("name") or r.get("name") or r["session"][:8])
        status = live.get(r["session"], {}).get("status", "ended")
        rows.append(f"## {name} ({status}) — {r.get('task') or 'no task given'}")
        rows.append(f"   cwd {r.get('cwd')}")
        for c in r.get("claims", []):
            parts = f" [{'; '.join(c['parts'])}]" if c.get("parts") else ""
            rows.append(f"   {c.get('lock'):8} {c.get('rel') or c['path']}{parts}"
                        + (f" — {c['note']}" if c.get("note") else ""))
    return "\n".join(rows) or "no claims"


def cmd_list(a):
    print(board())


def cmd_check(a):
    s = enclosing_session()
    sid = s["sessionId"] if s else ""
    for p in a.paths:
        here, elsewhere, root = claims_on(p, sid)
        if not here and not elsewhere:
            print(f"{p}: free")
        for r, l, c in here:
            print(describe(r, l, c, root))
            if c.get("parts") and os.path.exists(c["path"]):
                for name, s0, s1, _ in regions(Path(c["path"]).read_text(), c["parts"]):
                    print(f"  `{name}` is lines {s0+1}–{s1+1}")
        for r, c in elsewhere:
            print(f"- {who(r)} on the same path in {c.get('root')}: {c.get('lock')} {c.get('note')}")


def cmd_watch(a):
    """Print each new prompt with the claims it may run into, as it arrives."""
    inbox = state_dir() / "inbox.jsonl"
    inbox.touch()
    with open(inbox) as f:
        if not a.from_start:
            f.seek(0, 2)
        while True:
            line = f.readline()
            if not line:
                time.sleep(0.5)
                continue
            try:
                m = json.loads(line)
            except ValueError:
                continue
            root, _ = where(os.path.realpath(m.get("cwd") or "."))
            hits = overlaps(m["prompt"], m["session"], root) if root else []
            print(f"--- {m.get('name') or m['session'][:8]} in {m.get('cwd')}:")
            print("    " + m["prompt"][:1500].replace("\n", "\n    "))
            for r, l, c, words in hits:
                print(f"    may overlap {who(r)} on {c.get('rel')} (shared words: {', '.join(words)})")
            sys.stdout.flush()


def main():
    ap = argparse.ArgumentParser(prog="claim", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("task", help="say what this session is building")
    p.add_argument("text", nargs="+")
    p.set_defaults(fn=cmd_task)
    p = sub.add_parser("add", help="claim files, or parts of them")
    p.add_argument("paths", nargs="+")
    p.add_argument("--part", action="append", help="a line to find; the item it starts is claimed (repeatable)")
    p.add_argument("--lock", choices=["whole", "parts", "none"])
    p.add_argument("-m", help="what you'll do to it, and what others should leave alone")
    p.set_defaults(fn=cmd_add)
    p = sub.add_parser("release", help="let claims go")
    p.add_argument("paths", nargs="*")
    p.add_argument("--all", action="store_true")
    p.set_defaults(fn=cmd_release)
    sub.add_parser("list", help="every session's task and claims").set_defaults(fn=cmd_list)
    p = sub.add_parser("check", help="who has claimed these files, and what they said")
    p.add_argument("paths", nargs="+")
    p.set_defaults(fn=cmd_check)
    p = sub.add_parser("watch", help="follow new prompts and what they may run into (for the orchestrator)")
    p.add_argument("--from-start", action="store_true")
    p.set_defaults(fn=cmd_watch)
    p = sub.add_parser("hook", help="called by Claude Code hooks")
    p.add_argument("event", choices=sorted(HOOKS))
    a = ap.parse_args()
    if a.cmd == "hook":
        try:
            HOOKS[a.event](json.load(sys.stdin))
        except Exception as e:  # a broken hook must never stop a session
            print(f"claims hook {a.event}: {e}", file=sys.stderr)
        return
    a.fn(a)


if __name__ == "__main__":
    main()
