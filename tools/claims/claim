def hook_prompt(inp):
    sid = inp.get("session_id", "")
    prompt = inp.get("prompt", "")
    cwd = inp.get("cwd", "")
    rec = register(sid, cwd)
    save(rec)
    with open(state_dir() / "inbox.jsonl", "a") as f:
        f.write(json.dumps({"at": time.time(), "session": sid, "name": rec["name"], "cwd": cwd,
                            "prompt": prompt}) + "\n")
    root, _ = where(os.path.realpath(cwd or "."))
    if not root:
        return
    hits = overlaps(prompt, sid, root)
    peers = {}
    for r, l, c in worktree_claims(sid, root):
        peers.setdefault(who(r), []).append(rel(c["path"], root))
    if not peers:
        return
    lines = ["[claims] Other sessions working in this tree: " + "; ".join(
        f"{n}: {', '.join(sorted(set(ps)))}" for n, ps in peers.items())]
    if hits:
        lines.append("This prompt may overlap:")
        lines += [describe(r, l, c, root) for r, l, c, _ in hits]
    lines.append(f"Claim your files before editing (`{ME} add ...`).")
    emit("UserPromptSubmit", additionalContext="\n".join(lines))


