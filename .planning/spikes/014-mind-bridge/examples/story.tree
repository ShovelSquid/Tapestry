actor human designer
message "the cast"
create-node n1 perihelion.story/character@1
set n1 entity text "npc.rook"
set n1 name text "Rook"
set n1 npc bool true
set n1 role text "hangar mechanic, second shift"
set n1 voice text <<TEXT
Terse, dry, talks to machines more kindly than to people. Never says more than three sentences.
TEXT
create-node n2 perihelion.story/character@1
set n2 entity text "pilot.kade"
set n2 name text "Kade"
set n2 npc bool true
set n2 role text "pilot"
set n2 voice text "Quick and warm; deflects anything serious with a joke."
create-node n3 perihelion.story/character@1
set n3 entity text "npc.ines"
set n3 name text "Ines"
set n3 npc bool true
set n3 role text "quartermaster"
set n3 voice text "Precise, suspicious, counts everything aloud."
create-node n4 perihelion.story/character@1
set n4 entity text "npc.oda"
set n4 name text "Oda"
set n4 npc bool true
set n4 role text "base commander"
set n4 voice text "Formal and clipped; speaks in orders and dates."
create-node n5 perihelion.story/character@1
set n5 entity text "player"
set n5 name text "Vesper"
set n5 npc bool false
set n5 role text ""
set n5 voice text ""
create-node n6 perihelion.story/sample@1
set n6 line text "Left actuator's cooked. Again. You want it fixed or you want it fast?"
create-edge e1 n6 n1 sample-of
create-node n7 perihelion.story/sample@1
set n7 line text "...Good landing. Don't tell anyone I said that."
create-edge e2 n7 n1 sample-of
create-node n8 perihelion.story/sample@1
set n8 line text "If I die out there, tell Rook it was the actuator."
create-edge e3 n8 n2 sample-of
create-node n9 perihelion.story/sample@1
set n9 line text "Buy you a drink? Buy me a drink."
create-edge e4 n9 n2 sample-of
create-node n10 perihelion.story/sample@1
set n10 line text "Four cells. Four. Sign here."
create-edge e5 n10 n3 sample-of
create-node n11 perihelion.story/sample@1
set n11 line text "I don't do favors. I do inventory."
create-edge e6 n11 n3 sample-of
create-node n12 perihelion.story/sample@1
set n12 line text "Report at oh-six-hundred."
create-edge e7 n12 n4 sample-of
create-node n13 perihelion.story/sample@1
set n13 line text "Noted. Dismissed."
create-edge e8 n13 n4 sample-of
@end sha256:f2c4ab9c4193819464523eca3dcf98e38ccfbe7ccc27d476252e052b197b5df3
