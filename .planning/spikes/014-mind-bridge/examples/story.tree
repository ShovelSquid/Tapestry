set n18 text text "The salvage yard stopped trading with us, so there are no actuator parts"
create-node n19 perihelion.story/fact@1
set n19 canon bool true
set n19 text text "Oda cut the mechanics' rations to keep the pilots fed"
create-edge e13 n19 n4 about
